# AWS - Option 1: Use Bedrock API Key (NEW - Recommended)
BEDROCK_API_KEY=your_bedrock_api_key_here

# AWS - Option 2: Use IAM Access Keys (OLD - for AWS CLI/SDK)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_iam_access_key
AWS_SECRET_ACCESS_KEY=your_iam_secret_key

# Database
POSTGRES_USER=routemind
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=routemind_db
DATABASE_URL=postgresql+asyncpg://routemind:secure_password_change_me@db:5432/routemind_db

# Auth
SECRET_KEY=super_secret_jwt_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://redis:6379/0

# Services
AUTH_SERVICE_URL=http://auth-service:8000
ROUTING_SERVICE_URL=http://routing-service:8000